#!/usr/bin/env php
<?php

declare(strict_types=1);

use PhpJs\Ssg\Builder;
use PhpJs\Ssg\Exporter;
use PhpJs\Ssg\Paths;
use PhpJs\Ssg\Renderer;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

const USAGE = <<<TXT
Usage: bin/phpjs-ssg <command> [options]

Commands:
  build              compile the bundle, React and the polyfills into build/
  export             render every route into dist/ (static site generation)
  package            assemble a render-only tree for shipping (package/)
  serve              start a local server that renders on demand and caches
  cache:clear        drop every cached page
  compare            render every route under Node too and diff the two
  bench [--items N]  time one route both ways, interleaved

Options:
  --out DIR          export/package target
  --port N           serve port (default 8080)
  --host H           serve host (default 127.0.0.1)
  --engine NAME      serve default engine: aot | bytecode (default aot)
  --no-jit           serve without PHP's tracing JIT
  --items N          rows on the inventory page, for bench
  --ttl N            seconds a cached page stays fresh (default: forever)
  --no-cache         serve without the on-demand cache

TXT;

$command = $argv[1] ?? '';
$flags = [];
for ($i = 2; $i < $argc; $i++) {
    $arg = $argv[$i];
    $flags[$arg] = in_array($arg, ['--no-jit'], true) ? true : ($argv[++$i] ?? '');
}
$out = (string)($flags['--out'] ?? Paths::distDir());
$log = static fn (string $line): int|false => fwrite(STDOUT, $line . "\n");

try {
    switch ($command) {
        case 'build':
            $started = microtime(true);
            $manifest = (new Builder(Paths::appRoot(), Paths::buildDir(), Paths::entry()))->run($log);
            $log(sprintf(
                "\nbuilt in %.1f s. %d of %d React functions compiled to PHP.",
                microtime(true) - $started,
                $manifest['converted'],
                $manifest['seen']
            ));
            foreach ($manifest['refusals'] as $refusal) {
                $log(sprintf('  refused %-56s %d', $refusal['reason'], $refusal['count']));
            }
            break;

        case 'export':
            $renderer = Renderer::fromBuild(Paths::buildDir(), 'aot');
            $log(sprintf('boot %.1f ms, %d modules compiled', $renderer->bootMs, $renderer->modulesCompiled));
            $result = (new Exporter($renderer, $out, Paths::assetsDir()))->run($log);
            $log(sprintf(
                "\n%d pages, %.0f KB of HTML, %.1f ms of rendering total -> %s",
                $result['pages'],
                $result['bytes'] / 1024,
                $result['renderMs'],
                $out
            ));
            break;

        case 'serve':
            $host = (string)($flags['--host'] ?? '127.0.0.1');
            $port = (int)($flags['--port'] ?? 8080);
            $engine = (string)($flags['--engine'] ?? 'aot');
            if (!is_file(Paths::buildDir() . '/' . Builder::MANIFEST)) {
                fwrite(STDERR, "No build yet. Run `bin/phpjs-ssg build` first.\n");
                exit(1);
            }
            // opcache is what makes the generated PHP and the precompiled
            // bytecode worth anything, and it is off by default under the CLI
            // SAPI; the tracing JIT is worth about 20% on the interpreter.
            $ini = [
                'opcache.enable_cli=1',
                'opcache.memory_consumption=256',
                'opcache.max_accelerated_files=20000',
                // Timestamp validation stays *on*, unlike a production tuning
                // guide's advice: a rebuild has to be picked up, and a cache
                // that outlives the file it came from is the wrong default for
                // anything that loads generated code.
            ];
            $ini[] = isset($flags['--no-jit'])
                ? 'opcache.jit=off'
                : 'opcache.jit=tracing';
            $ini[] = 'opcache.jit_buffer_size=' . (isset($flags['--no-jit']) ? '0' : '64M');

            putenv('PHPJS_SSG_BUILD=' . Paths::buildDir());
            putenv('PHPJS_SSG_DIST=' . $out);
            putenv('PHPJS_SSG_ENGINE=' . $engine);
            putenv('PHPJS_SSG_CACHE=' . (isset($flags['--no-cache']) ? '' : Paths::cacheDir()));
            if (isset($flags['--ttl'])) {
                putenv('PHPJS_SSG_TTL=' . (int)$flags['--ttl']);
            }

            $log("php-js SSG demo on http://$host:$port/");
            $log(isset($flags['--no-cache'])
                ? '  rendering every request (cache off)'
                : '  first request to a page renders it, the rest are served from ' . Paths::cacheDir());
            $log('  toolbar switches between ahead-of-time PHP, bytecode and the exported files');
            $log('  /inventory/?items=2000 makes the render cost impossible to miss');
            $log('  Ctrl-C to stop');
            $cmd = array_merge(
                [PHP_BINARY],
                array_merge(...array_map(static fn (string $d): array => ['-d', $d], $ini)),
                ['-S', "$host:$port", '-t', Paths::publicDir(), Paths::publicDir() . '/index.php']
            );
            $process = proc_open($cmd, [STDIN, STDOUT, STDERR], $pipes);
            exit(is_resource($process) ? proc_close($process) : 1);

        case 'package': {
            $target = (string)($flags['--out'] ?? Paths::distributionDir());
            $result = (new PhpJs\Ssg\Distribution(Paths::buildDir(), Paths::appRoot()))
                ->writeTo($target, $log);
            $log(sprintf(
                "\nready to ship: %s\n  Renderer::fromDistribution('%s')",
                $target,
                basename($target)
            ));
            break;
        }

        case 'cache:clear': {
            $cache = new PhpJs\Ssg\PageCache(Paths::cacheDir());
            $log(sprintf('%d cached files removed from %s', $cache->clear(), Paths::cacheDir()));
            break;
        }

        case 'compare':
            exit(compareWithNode($log));

        case 'bench':
            benchBothWays((int)($flags['--items'] ?? 250), $log);
            break;

        default:
            fwrite($command === '' ? STDOUT : STDERR, USAGE);
            exit($command === '' ? 0 : 2);
    }
} catch (Throwable $e) {
    fwrite(STDERR, get_class($e) . ': ' . $e->getMessage() . "\n");
    exit(1);
}

/**
 * Render every route under both runtimes and require the HTML to match byte for
 * byte. This is the demo's real correctness claim: not that the pages look
 * right, but that php-js and Node produce the same bytes from the same source.
 */
function compareWithNode(callable $log): int
{
    if (!is_file(Paths::nodeEntry())) {
        fwrite(STDERR, "No Node bundle. Run `npm run build` first.\n");
        return 1;
    }
    $renderer = Renderer::fromBuild(Paths::buildDir(), 'aot');
    // The path comes through the environment: with `node -e`, argv does not
    // include a script name and its indices are easy to get wrong.
    $script = <<<'JS'
    const entry = require(process.env.PHPJS_SSG_NODE_ENTRY);
    const routes = JSON.parse(entry.routeManifest());
    const out = {};
    for (const route of routes) { out[route] = entry.renderPage(route, '').html; }
    process.stdout.write(JSON.stringify(out));
    JS;
    $descriptors = [1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
    $node = proc_open(
        ['node', '-e', $script],
        $descriptors,
        $pipes,
        Paths::packageRoot(),
        ['PHPJS_SSG_NODE_ENTRY' => Paths::nodeEntry()] + getenv()
    );
    if (!is_resource($node)) {
        fwrite(STDERR, "Could not start node.\n");
        return 1;
    }
    $stdout = (string)stream_get_contents($pipes[1]);
    $stderr = (string)stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    if (proc_close($node) !== 0) {
        fwrite(STDERR, "node failed: $stderr\n");
        return 1;
    }
    $nodeHtml = json_decode($stdout, true);
    if (!is_array($nodeHtml)) {
        fwrite(STDERR, "node produced no usable output.\n");
        return 1;
    }

    $mismatched = 0;
    foreach ($renderer->routes() as $route) {
        $ours = $renderer->render($route)->html;
        // Node's side is React's markup only; ours has the doctype in front.
        $theirs = "<!DOCTYPE html>\n" . ($nodeHtml[$route] ?? '');
        $same = $ours === $theirs;
        $mismatched += $same ? 0 : 1;
        $log(sprintf('%-28s %s  %6.0f KB', $route, $same ? 'identical' : 'DIFFERS  ', strlen($ours) / 1024));
    }
    $log($mismatched === 0
        ? "\nevery route is byte-identical to Node"
        : "\n$mismatched route(s) differ");
    return $mismatched === 0 ? 0 : 1;
}

/**
 * Time one route both ways, interleaved.
 *
 * Interleaved because this host's own speed drifts: alternating the two so they
 * see the same conditions is the only way the ratio means anything.
 */
function benchBothWays(int $items, callable $log): void
{
    $renderers = [];
    foreach (Renderer::ENGINES as $engine) {
        $renderers[$engine] = Renderer::fromBuild(Paths::buildDir(), $engine);
        $renderers[$engine]->render('/inventory/', ['items' => $items]);   // warm up
    }
    $log(sprintf('/inventory/?items=%d, 7 interleaved pairs', $items));
    $log(sprintf('%-12s %12s %12s %10s', '', 'bytecode', 'aot', 'change'));
    $samples = ['aot' => [], 'bytecode' => []];
    for ($i = 0; $i < 7; $i++) {
        foreach (['bytecode', 'aot'] as $engine) {
            $samples[$engine][] = $renderers[$engine]->render('/inventory/', ['items' => $items])->renderMs;
        }
        $log(sprintf(
            '%-12s %9.2f ms %9.2f ms %9.1f%%',
            'pair ' . ($i + 1),
            $samples['bytecode'][$i],
            $samples['aot'][$i],
            ($samples['aot'][$i] / $samples['bytecode'][$i] - 1) * 100
        ));
    }
    $median = static function (array $values): float {
        sort($values);
        return $values[intdiv(count($values), 2)];
    };
    $b = $median($samples['bytecode']);
    $a = $median($samples['aot']);
    $log(sprintf(
        "\nmedian %.2f ms bytecode, %.2f ms ahead-of-time: %.1f%%",
        $b,
        $a,
        ($a / $b - 1) * 100
    ));
}
