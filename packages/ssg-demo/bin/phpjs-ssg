#!/usr/bin/env php
<?php

declare(strict_types=1);

use PhpJs\Ssg\Builder;
use PhpJs\Ssg\Exporter;
use PhpJs\Ssg\Paths;
use PhpJs\Ssg\Renderer;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

const USAGE = <<<TXT
Usage: bin/phpjs-ssg <command> [options]

Commands:
  build              compile the bundle, React and the polyfills into build/
  export             render every route into dist/ (static site generation)
  package            assemble a render-only tree for shipping (package/)
  serve              start a local server that renders on demand and caches
  cache:clear        drop every cached page

Options:
  --out DIR          export/package target
  --port N           serve port (default 8080)
  --host H           serve host (default 127.0.0.1)
  --engine NAME      serve default engine: aot | bytecode (default aot)
  --no-jit           serve without PHP's tracing JIT
  --ttl N            seconds a cached page stays fresh (default: forever)
  --no-cache         serve without the on-demand cache

TXT;

$command = $argv[1] ?? '';
$flags = [];
for ($i = 2; $i < $argc; $i++) {
    $arg = $argv[$i];
    $flags[$arg] = in_array($arg, ['--no-jit'], true) ? true : ($argv[++$i] ?? '');
}
$out = (string)($flags['--out'] ?? Paths::distDir());
$log = static fn (string $line): int|false => fwrite(STDOUT, $line . "\n");

try {
    switch ($command) {
        case 'build':
            $started = microtime(true);
            $manifest = (new Builder(Paths::appRoot(), Paths::buildDir()))->run($log);
            $log(sprintf(
                "\nbuilt in %.1f s. %d of %d React functions compiled to PHP.",
                microtime(true) - $started,
                $manifest['converted'],
                $manifest['seen']
            ));
            foreach ($manifest['refusals'] as $refusal) {
                $log(sprintf('  refused %-56s %d', $refusal['reason'], $refusal['count']));
            }
            break;

        case 'export':
            $renderer = Renderer::fromBuild(Paths::buildDir(), 'aot');
            $log(sprintf('boot %.1f ms, %d modules compiled', $renderer->bootMs, $renderer->modulesCompiled));
            $result = (new Exporter($renderer, $out, Paths::assetsDir()))->run($log);
            $log(sprintf(
                "\n%d pages, %.0f KB of HTML, %.1f ms of rendering total -> %s",
                $result['pages'],
                $result['bytes'] / 1024,
                $result['renderMs'],
                $out
            ));
            break;

        case 'serve':
            $host = (string)($flags['--host'] ?? '127.0.0.1');
            $port = (int)($flags['--port'] ?? 8080);
            $engine = (string)($flags['--engine'] ?? 'aot');
            if (!is_file(Paths::buildDir() . '/' . Builder::MANIFEST)) {
                fwrite(STDERR, "No build yet. Run `bin/phpjs-ssg build` first.\n");
                exit(1);
            }
            // opcache is what makes the generated PHP and the precompiled
            // bytecode worth anything, and it is off by default under the CLI
            // SAPI; the tracing JIT is worth about 20% on the interpreter.
            $ini = [
                'opcache.enable_cli=1',
                'opcache.memory_consumption=256',
                'opcache.max_accelerated_files=20000',
                // Timestamp validation stays *on*, unlike a production tuning
                // guide's advice: a rebuild has to be picked up, and a cache
                // that outlives the file it came from is the wrong default for
                // anything that loads generated code.
            ];
            $ini[] = isset($flags['--no-jit'])
                ? 'opcache.jit=off'
                : 'opcache.jit=tracing';
            $ini[] = 'opcache.jit_buffer_size=' . (isset($flags['--no-jit']) ? '0' : '64M');

            putenv('PHPJS_SSG_BUILD=' . Paths::buildDir());
            putenv('PHPJS_SSG_DIST=' . $out);
            putenv('PHPJS_SSG_ENGINE=' . $engine);
            putenv('PHPJS_SSG_CACHE=' . (isset($flags['--no-cache']) ? '' : Paths::cacheDir()));
            if (isset($flags['--ttl'])) {
                putenv('PHPJS_SSG_TTL=' . (int)$flags['--ttl']);
            }

            $log("php-js SSG demo on http://$host:$port/");
            $log(isset($flags['--no-cache'])
                ? '  rendering every request (cache off)'
                : '  first request to a page renders it, the rest are served from ' . Paths::cacheDir());
            $log('  toolbar switches between ahead-of-time PHP, bytecode and the exported files');
            $log('  /inventory/?items=2000 makes the render cost impossible to miss');
            $log('  Ctrl-C to stop');
            $cmd = array_merge(
                [PHP_BINARY],
                array_merge(...array_map(static fn (string $d): array => ['-d', $d], $ini)),
                ['-S', "$host:$port", '-t', Paths::publicDir(), Paths::publicDir() . '/index.php']
            );
            $process = proc_open($cmd, [STDIN, STDOUT, STDERR], $pipes);
            exit(is_resource($process) ? proc_close($process) : 1);

        case 'package': {
            $target = (string)($flags['--out'] ?? Paths::distributionDir());
            $result = (new PhpJs\Ssg\Distribution(Paths::buildDir(), Paths::appRoot()))
                ->writeTo($target, $log);
            $log(sprintf(
                "\nready to ship: %s\n  Renderer::fromDistribution('%s')",
                $target,
                basename($target)
            ));
            break;
        }

        case 'cache:clear': {
            $cache = new PhpJs\Ssg\PageCache(Paths::cacheDir());
            $log(sprintf('%d cached files removed from %s', $cache->clear(), Paths::cacheDir()));
            break;
        }

        default:
            fwrite($command === '' ? STDOUT : STDERR, USAGE);
            exit($command === '' ? 0 : 2);
    }
} catch (Throwable $e) {
    fwrite(STDERR, get_class($e) . ': ' . $e->getMessage() . "\n");
    exit(1);
}
