{
  "name": "ryohey/php-js-ssg-demo",
  "description": "Local static-site-generation demo: React rendered to HTML by the php-js runtime",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ryohey/php-js": "dev-main",
    "ryohey/php-js-aot": "dev-main",
    "ryohey/php-js-node-compat": "dev-main",
    "ryohey/php-js-transpile": "dev-main"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "PhpJs\\Ssg\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PhpJs\\Ssg\\Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../..",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "../node-compat",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "../php-transpile",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "../aot",
      "options": { "symlink": true }
    },
    {
      "type": "vcs",
      "url": "https://github.com/ryohey/peast.git"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  },
  "bin": [
    "bin/phpjs-ssg"
  ]
}
