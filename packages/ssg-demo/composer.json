{
    "name": "ryohey/phext-ssg-demo",
    "description": "A small React site rendered by php-js, built and served with phext",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ryohey/phext-cli": "dev-main"
    },
    "repositories": [
        { "type": "path", "url": "../.." },
        { "type": "path", "url": "../node-compat" },
        { "type": "path", "url": "../php-transpile" },
        { "type": "path", "url": "../strip-types" },
        { "type": "path", "url": "../aot" },
        { "type": "path", "url": "../phext" },
        { "type": "path", "url": "../phext-cli" },
        { "type": "vcs", "url": "https://github.com/ryohey/peast.git" }
    ],
    "config": { "sort-packages": true },
    "minimum-stability": "dev",
    "prefer-stable": true
}
