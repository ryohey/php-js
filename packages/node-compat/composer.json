{
    "name": "ryohey/php-js-node-compat",
    "description": "CommonJS module loading and a minimal Node-style host surface for the php-js runtime",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ryohey/php-js": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PhpJs\\Node\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpJs\\Node\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
