{
    "name": "ryohey/phext-cli",
    "description": "The phext command line: build, start and export a phext site",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ryohey/phext": "dev-main",
        "ryohey/php-js-aot": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PhpJs\\PhextCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpJs\\PhextCli\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/phext"
    ],
    "repositories": [
        { "type": "path", "url": "../.." },
        { "type": "path", "url": "../node-compat" },
        { "type": "path", "url": "../php-transpile" },
        { "type": "path", "url": "../strip-types" },
        { "type": "path", "url": "../aot" },
        { "type": "path", "url": "../phext" },
        { "type": "vcs", "url": "https://github.com/ryohey/peast.git" }
    ],
    "config": { "sort-packages": true },
    "minimum-stability": "dev",
    "prefer-stable": true
}
