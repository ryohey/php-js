{
    "name": "ryohey/php-js",
    "description": "Experimental JS runtime on pure PHP: ES5.1 subset compiled to bytecode and executed by a PHP VM",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "mck89/peast": "^1.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PhpJs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpJs\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/phpjs"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
